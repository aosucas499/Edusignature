[Unit]
Description=EduSignage Pi - Servidor Web FastAPI (Sin privilegios root)
After=network-online.target edusignage-system-helper.service
Wants=network-online.target

[Service]
Type=simple
User=edusignage
Group=edusignage
WorkingDirectory=/opt/edusignage/app
Environment=EDUSIGNAGE_DB=/opt/edusignage/data/edusignage.db
Environment=EDUSIGNAGE_MEDIA=/opt/edusignage/media
Environment=EDUSIGNAGE_WEB_DIST=/opt/edusignage/web
Environment=EDUSIGNAGE_BACKUPS=/opt/edusignage/backups
Environment=EDUSIGNAGE_PLAYER_SOCK=/run/edusignage/player.sock
Environment=EDUSIGNAGE_HELPER_SOCK=/run/edusignage/syshelper.sock
RuntimeDirectory=edusignage
RuntimeDirectoryPreserve=yes
ExecStart=/opt/edusignage/venv/bin/uvicorn main:app --host 0.0.0.0 --port 8080 --workers 1
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
