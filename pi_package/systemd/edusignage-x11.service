[Unit]
Description=EduSignage Pi - Sesión Ligera X11 + Openbox (Sin escritorio)
After=systemd-user-sessions.service

[Service]
Type=simple
User=edusignage
Group=edusignage
PAMName=login
TTYPath=/dev/tty1
StandardInput=tty
StandardOutput=journal
ExecStart=/usr/bin/xinit /etc/xdg/openbox/edusignage-xinitrc -- :0 vt1 -nolisten tcp
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
