[Unit]
Description=EduSignage Pi - Sesión Ligera X11 + Openbox (Sin escritorio)
Conflicts=getty@tty1.service autologin@tty1.service lightdm.service greetd.service gdm3.service sddm.service xdm.service display-manager.service
After=systemd-user-sessions.service plymouth-quit.service plymouth-quit-wait.service edusignage-system-helper.service

[Service]
Type=simple
User=edusignage
Group=edusignage
WorkingDirectory=/opt/edusignage
StandardOutput=journal
StandardError=journal
Environment=HOME=/opt/edusignage
Environment=DISPLAY=:0
Environment=XAUTHORITY=/opt/edusignage/.Xauthority
Environment=XDG_RUNTIME_DIR=/run/edusignage/xdg
ExecStartPre=+/bin/mkdir -p /run/edusignage/xdg
ExecStartPre=+/bin/chown edusignage:edusignage /run/edusignage /run/edusignage/xdg
ExecStartPre=+/bin/chmod 0770 /run/edusignage
ExecStartPre=+/bin/chmod 0700 /run/edusignage/xdg
ExecStartPre=+/bin/sh -c 'if [ -f /tmp/.X0-lock ]; then p=$(tr -dc "0-9" < /tmp/.X0-lock); if [ -z "$p" ] || ! kill -0 "$p" 2>/dev/null; then rm -f /tmp/.X0-lock /tmp/.X11-unix/X0 || true; fi; fi'
ExecStartPre=+/bin/sh -c 'if command -v plymouth >/dev/null 2>&1; then plymouth quit --wait || true; fi'
ExecStartPre=+/bin/sh -c 'for i in $(seq 1 20); do [ -e /dev/dri/card0 ] || [ -e /dev/dri/card1 ] || [ -e /dev/fb0 ] && break; sleep 0.25; done'
ExecStartPre=+/bin/chvt 1
ExecStart=/bin/bash /opt/edusignage/app/start_x11.sh
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
